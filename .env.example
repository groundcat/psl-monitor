# Copy to .env and edit. All credentials live here, never in the database.

# Public URL (used for links in emails; https:// enables secure cookies)
BASE_URL=http://localhost:8080
# Host port published by docker compose
HOST_PORT=8080

# Initial admin, created only when the database has no users yet.
# Leave empty to create the first admin via the /setup page instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=

# SMTP for weekly reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (default, port 587) | tls (implicit, port 465) | none (plaintext, e.g. local relay)
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PSL Monitor <pslmon@example.com>
SMTP_INSECURE_SKIP_VERIFY=false

# Set true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Override secure-cookie detection (defaults to true when BASE_URL is https)
#SECURE_COOKIES=true

LOG_LEVEL=info

# WHOIS / web-WHOIS fallback (reg233/whois-domain-lookup sidecar, built from
# the git submodule third_party/whois-domain-lookup). docker compose wires it
# up automatically (http://whois); set to empty to disable the fallback.
#WHOIS_FALLBACK_URL=http://whois
# Optional shared secret; protects the sidecar's API (sent as SHA256 bearer token)
WHOIS_FALLBACK_PASSWORD=
# User-Agent the sidecar uses for web-based WHOIS lookups (empty = upstream default)
WHOIS_USER_AGENT=
